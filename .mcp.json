{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--ignore-https-errors"
      ]
    },
    "glif": {
      "command": "npx",
      "args": [
        "-y",
        "@glifxyz/glif-mcp-server"
      ],
      "env": {
        "GLIF_API_TOKEN": "${GLIF_API_TOKEN}"
      }
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=pvsokcdebbcmxkekthnt&read_only=true"
    }
  }
}