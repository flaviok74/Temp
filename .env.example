# ── WhatsApp Business Cloud API credentials ──────────────────────────────
# Get these from https://developers.facebook.com/ → your App → WhatsApp → API Setup

# Permanent (or temporary) access token used to call the Graph API
WHATSAPP_TOKEN=your_permanent_access_token

# Phone number ID of the WhatsApp business number (NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Graph API version to target
GRAPH_API_VERSION=v21.0

# ── Webhook configuration ────────────────────────────────────────────────
# A string you invent. You must enter the SAME value in the Meta App
# dashboard when configuring the webhook callback URL.
WEBHOOK_VERIFY_TOKEN=choose_a_random_verify_token

# App Secret (App → Settings → Basic). Used to validate the X-Hub-Signature-256
# header on incoming webhooks. Leave empty to skip signature verification.
WHATSAPP_APP_SECRET=your_app_secret

# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
